NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fitrybe

# JWT secrets. Use long random strings; changing them invalidates all sessions.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins. Required in production —
# an empty value there rejects every cross-origin browser caller. Native
# mobile clients send no Origin header and are unaffected.
CORS_ORIGINS=

# Cloudflare R2 object storage.
#   Account ID + API token: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
#   Public URL: the bucket's r2.dev subdomain, or a connected custom domain
# Blank values fall back to local disk in development. Production refuses to
# start without them, because its filesystem is wiped on every redeploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitrybe-media
R2_PUBLIC_URL=

# Google Sign-In. OAuth client IDs from the Google Cloud console, one per
# platform. Not secrets: they ship inside the app. What they buy is that the
# server only accepts ID tokens minted for these clients, so a token obtained
# for some other app cannot be replayed here.
#   Web client ID     — the audience Android stamps into its ID tokens
#   iOS client ID     — the audience iOS stamps into its own
# Blank values make the Google button answer 503 rather than accepting tokens
# the server cannot verify. Android needs no client ID of its own here; it is
# recognised by package name plus signing certificate fingerprint instead.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple. The audience of an identity token is whichever client
# asked for it, so list every client this app signs in from.
#   APPLE_BUNDLE_ID  — the iOS bundle identifier, for the native flow
#   APPLE_SERVICE_ID — a Services ID, only if you add the web/Android redirect
# Blank makes the Apple button answer 503 rather than accepting tokens the
# server cannot verify. No key or secret is needed: verifying an identity token
# uses only Apple's public keys.
APPLE_BUNDLE_ID=com.fitrybe.fitrybe
APPLE_SERVICE_ID=

# Outgoing email, used by password reset. Two ways in; the first one set wins.
#
# 1. RESEND_API_KEY — an HTTPS call on port 443. Preferred, because hosting
#    platforms routinely block outbound SMTP so their address space cannot be
#    used for spam. The symptom of that block is a bare connect timeout
#    (ETIMEDOUT on CONN), which looks like bad credentials but is the port never
#    opening. Nothing blocks 443.
RESEND_API_KEY=

# 2. SMTP — kept for hosts where it works, and for a local mail catcher.
#    Port 465 is implicit TLS; 587 starts plaintext and upgrades.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The sender. Providers only accept a domain you have verified with them, so
# this cannot be an arbitrary address.
MAIL_FROM=Fitrybe <no-reply@fitrybe.app>

# Apple token revocation, needed only for account deletion. App Review requires
# an app offering Sign in with Apple to revoke the account with Apple when it is
# deleted, and revoking needs a signed client secret. Verifying a sign-in does
# NOT need any of this — that uses Apple's public keys — so deletion works
# without them, just out of compliance.
#   APPLE_TEAM_ID    — Apple Developer portal, top right
#   APPLE_KEY_ID     — the Key ID of a "Sign in with Apple" key
#   APPLE_PRIVATE_KEY— the .p8 file contents, newlines escaped as \n, on one
#                      line. This one IS a secret.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
